# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Único e-mail com acesso ao painel
ALLOWED_EMAIL=voce@exemplo.com

# Gere com: npm run secrets
API_KEY=
MCP_SECRET=
CRON_SECRET=

# URL pública do app (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chloe com IA (opcional; sem chave ela usa só as regras em português).
# Tentados nesta ordem; o primeiro que responder vence.
GROQ_API_KEY=
# GROQ_MODEL_FAST=llama-3.3-70b-versatile
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
