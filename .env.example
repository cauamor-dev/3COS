# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Único e-mail com acesso ao painel
ALLOWED_EMAIL=voce@exemplo.com

# Gere com: npm run secrets
API_KEY=
MCP_SECRET=
CRON_SECRET=

# URL pública do app (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chloe com IA (opcional; sem chave ela usa só as regras em português).
# Um provedor explícito; sem fallback automático para outro destino.
CHLOE_AI_ENABLED=0
CHLOE_FREE_TIER_CONFIRMED=0
CHLOE_EVALUATION_PASSED=0
CHLOE_PROVIDER=groq
CHLOE_DAILY_CALLS=100
CHLOE_DAILY_TOKENS=100000
GROQ_API_KEY=
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Dispatcher permanece parado até flag e controle da Equipe serem habilitados.
CENTRAL_DISPATCHER_ENABLED=0
# Runner sob demanda no PC pessoal: nunca usar service_role ou segredo legado.
CENTRAL_URL=
CENTRAL_CLIENT_TOKEN=
CENTRAL_RUNNER_ROOT=
CENTRAL_RUNNER_ENABLED=0
